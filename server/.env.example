# PostgreSQL connection string
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/pickle

# Secret used to sign JWTs - change this to a long random string in production
JWT_SECRET=change-this-to-a-long-random-secret

# Port the API server listens on
PORT=3001

# Comma-separated list of allowed origins for CORS (your frontend dev/prod URLs)
CORS_ORIGIN=http://localhost:5173

# Path to the Blender executable (used by the avatar generation pipeline)
BLENDER_PATH=blender
# Path to the single neutral base avatar .glb file (already contains the shape keys
# Key_Chest/Key_Waist/Key_Hip/Key_Shoulder/Key_Neck) - see server/blender/README.md
NEUTRAL_BASE_AVATAR=./blender/neutral_base_avatar.glb
# Max time (ms) to let a single avatar generation run before it's killed
BLENDER_TIMEOUT_MS=60000
